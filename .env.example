HOST=127.0.0.1
# ^ set to 0.0.0.0 if running via Docker
PORT=8080
DB_PATH=sqlite:///./users.db
SECRET_KEY=replace_with_a_long_random_value_e.g._openssl_rand_hex_32
ALGORITHM=HS256
REFRESH_TOKEN_EXPIRE_DAYS=30
ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMITER_ENABLED=true
RATE_LIMITER_PER_MINUTE=20
ENABLE_AUTH=false
DEBUG=true
# ^ set to false if running via Docker/production